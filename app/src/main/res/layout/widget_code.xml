<?xml version="1.0" encoding="utf-8"?>
<!-- Большой виджет «Код дня» (4×2). Тексты по умолчанию — для превью в списке виджетов. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/logo_small"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:id="@+id/w_k"
                android:text="@string/widget_k"
                android:textColor="#8B93A8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="18dp"
                android:layout_height="18dp">

                <ImageView
                    android:id="@+id/w_tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tile_shape"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/w_tile_m"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="JS"
                    android:textColor="#16181D"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/w_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:text="JavaScript"
                android:textColor="#8B93A8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="filter and map"
            android:textColor="#E7EAF3"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/code_bg"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="5"
            android:paddingStart="11dp"
            android:paddingTop="8dp"
            android:paddingEnd="11dp"
            android:paddingBottom="8dp"
            android:text="const cheap = prices\n  .filter(p =&gt; p &lt; 100)"
            android:textColor="#D8DEE9"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_expl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:text="filter keeps the elements that pass the check, and map transforms each of them."
            android:textColor="#8B93A8"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
