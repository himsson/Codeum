<?xml version="1.0" encoding="utf-8"?>
<!-- Фон виджета: тёмная карточка с синим отблеском слева сверху, как в приложении -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#25345C"
                android:centerColor="#161B25"
                android:endColor="#152A2E" />
            <stroke android:width="1dp" android:color="#33456F" />
        </shape>
    </item>
</layer-list>
