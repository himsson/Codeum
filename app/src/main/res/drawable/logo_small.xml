<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:angle="315"
                android:startColor="#5B8CFF"
                android:endColor="#3DDBC4" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/logo_mark"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp" />
</layer-list>
